$this->registerJs("
    var table;
    var jenis;
    var columns = ".json_encode($api['columns']).";
    var tgl = columns.length - 1;
    var jenis = columns.length - 2;

    $(document).ready(function(){
        $('.flex-1').addClass('hidden')
        table = $('#lap-sensus-harian-rajal').docoTabel({
            sorting: false,
            displayLength: 100,
            processing: true,
            serverSide: true,
            paging: false,
            ordering: false,
            scrollX: true,
            lengthChange: false,
            ajax: {
                url: baseUrl+'rm/lap-sensus-harian-pasien-rajal/get-data',
                type: 'GET',
                data: function (col) {
                    for (i = 0; i < col.columns.length; i++) {
                        if (col.columns[i].data === 'jenis_pendaftaran' || col.columns[i].data === 'tgl_pendaftaran') { 

                        } else {
                            col.columns.splice(i, 1); 
                        }
                    }
                }
            },
            columns: columns,
            infoCallback: function( settings, start, end, max, total, pre ) {
                return 'Showing '+ start +' to '+ total +' of '+ total +' entries'
            },
            drawCallback: function(e) {
                var api = this.api();

                for (var i = 0; api.rows().count() > i; i++) {
                    var rowData = api.row(i).data();
                    var rowNode = api.row(i).node();

                    if(rowData.is_header == 0 || rowData.is_header == 2) {
                        $(rowNode).addClass('t-b');
                    }

                    if(rowData.is_header == 0 || rowData.ruangan_nama == '<b>TOTAL</b>') {
                        $(rowNode).addClass('bg-sub-tot');
                    }
                }
            }
        });
        $('.dataTables_filter').hide();

        $('.filter-form').datatableBootstrapFilter(table, 
        [
            [
                ".$api['tgl'].",
                \"<div class='input-group'><input value=".date('d-M-Y')." type='text' id='rangeDemoStart' class='form-control startDate' /><span class='input-group-addon' style='border-left: 0; border-right: 0;'>-</span><input value=".date('d-M-Y')." type='text' id='rangeDemoFinish' class='form-control endDate' /><input type='text' style='display:none' class='targetDate' col-index=2 readonly='true'></div>\"
            ],
            [
                ".$api['jenis'].",
                \"<div class='form-group'>".preg_replace("/[\n\t\r]/i", '', preg_replace("/[\"]/i", '\'',
                    Html::dropDownList('jenis_pendaftaran', $api['jenis_pendaftaran'][0]['lookup_id'],
                    ArrayHelper::map($api['jenis_pendaftaran'], 'lookup_id', 'lookup_name'),
                        [
                            'id' => 'filter_jenis_pendaftaran',
                            'class' => 'form-control select2 selectJenisPendaftaran',
                            'style'=>'width:100%;',
                            'prompt' => '--- Pilih ---'
                        ]
                    )
                ))."<div>\"
            ],
        ],
        {
            //posisi kolom dan grid
            ".$api['tgl'].":0,
            ".$api['jenis'].":1,
        });
        
        dateRangeHelper('.startDate','.endDate','.targetDate');

        $(document).on('click', '#reset', function(){
            let valDef = ".$api['jenis_pendaftaran'][0]['lookup_id']."
            let valName = '".$api['jenis_pendaftaran'][0]['lookup_name']."'
        })
    });

", View::POS_END)
?>