{
    "name": "dbdg/sirs",
    "type": "web-app",
    "require": {
        "sirs/newsimrs-vendor": "*"
    },
    "minimum-stability": "dev",
    "authors": [
        {
            "name": "yaya",
            "email": "setyabudi@docotel.com"
        }
    ],
    "autoload": {
        "files": [
        ],"classmap": [
            
        ],
        "psr-4": {
            "Doco\\": "modules/",
            "yii\\gii\\": "vendor/sirs/newsimrs-vendor/yiisoft/yii2-gii/src/",
            "yii\\bootstrap\\": "vendor/sirs/newsimrs-vendor/yiisoft/yii2-bootstrap/src/",
            "GuzzleHttp\\": "vendor/sirs/newsimrs-vendor/guzzlehttp/guzzle/src/"
        }
    },
    "repositories": [{
        "type": "package",
        "package": {
            "name": "sirs/newsimrs-vendor",
            "version": "1.2",
            "type": "yii-module",
            "source": {
                "url": "http://gitlab.docotel.net/dbdg/newsimrs-vendor.git",
                "type": "git",
                "reference": "frontend"
            }
        }
    }],
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        },
        "asset-installer-paths": {
            "npm-asset-library": "vendor/sirs/newsimrs-vendor/npm",
            "bower-asset-library": "vendor/sirs/newsimrs-vendor/bower"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "config": {
        "secure-http": false,
        "process-timeout": 1800,
        "fxp-asset":{
            "installer-paths": {
                "npm-asset-library": "vendor/sirs/newsimrs-vendor/npm",
                "bower-asset-library": "vendor/sirs/newsimrs-vendor/bower"
            },
            "vcs-driver-options": {
                "github-no-api": true
            },
            "git-skip-update": "2 days",
            "pattern-skip-version": "(-build|-patch)"
        }
    }
}
